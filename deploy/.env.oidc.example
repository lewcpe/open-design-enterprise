# deploy/docker-compose.oidc.yml — multi-user OpenDesign behind OIDC.
# Copy to deploy/.env.oidc and fill in. Never commit the filled-in file.

# Public origin users open in the browser (no trailing slash).
OPEN_DESIGN_PUBLIC_URL=https://design.example.com
# Host name only, used by the bundled Caddy (--profile tls).
OPEN_DESIGN_HOST=design.example.com
# "internal" = Caddy internal CA (intranet); an email address = public ACME cert.
CADDY_TLS=internal

# Comma-separated emails allowed to change shared settings
# (API keys, agent selection, MCP servers, connectors).
OD_ADMIN_EMAILS=admin@example.com

# ---- OIDC (register a confidential client with redirect URI
#      ${OPEN_DESIGN_PUBLIC_URL}/oauth2/callback) ----
# Keycloak:  https://sso.example.com/realms/<realm>
# Entra ID:  https://login.microsoftonline.com/<tenant-id>/v2.0
# Google:    https://accounts.google.com
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Restrict sign-in by email domain (comma-separated). To also require an IdP
# group, add OAUTH2_PROXY_ALLOWED_GROUPS to the oauth2-proxy service and the
# matching scope (e.g. "groups" for Keycloak) here.
OIDC_EMAIL_DOMAINS=example.com
OIDC_EXTRA_SCOPES=
# Entra ID does not send email_verified; set true there only.
OIDC_ALLOW_UNVERIFIED_EMAIL=false

# 32-byte secret: openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=
# Without Caddy, an external TLS load balancer on this host targets this port.
OAUTH2_PROXY_PUBLISH=127.0.0.1:4180

# ---- Model providers (shared by all users) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# ---- Resources ----
OPEN_DESIGN_MEM_LIMIT=2g
NODE_OPTIONS=--max-old-space-size=1024
# Image tag built from this fork (docker compose ... up --build).
OPEN_DESIGN_IMAGE=open-design-teams:local
